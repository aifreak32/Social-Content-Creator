# API Keys for AI Content Generation
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Social Media API Credentials
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Database Configuration
DATABASE_URL=sqlite:///social_content_creator.db

# Agent Configuration
TREND_ANALYSIS_INTERVAL_MINUTES=30
CONTENT_GENERATION_INTERVAL_HOURS=4
NICHE_ANALYSIS_INTERVAL_HOURS=24
STRATEGY_OPTIMIZATION_INTERVAL_HOURS=12

# Content Generation Settings
MIN_ENGAGEMENT_SCORE=7.0
MAX_POSTS_PER_DAY=10
VIDEO_GENERATION_ENABLED=true
IMAGE_GENERATION_ENABLED=true

# Monetization Thresholds
MIN_FOLLOWERS_FOR_MONETIZATION=10000
TARGET_ENGAGEMENT_RATE=0.05
